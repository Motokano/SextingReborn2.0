  "knowledge_policy": {
    "owner": "character",
    "default_known": false,
    "identity_scope": "item_id",
    "repair_use_scope": "item_id",
    "compatibility_scope": ["item_id", "component_id"],
    "undiscovered": "不生成条目、剪影、问号、锁定项或未发现数量。",
    "visible_name": {
      "known": ["identity_known", "survival_language>=3"],
      "fallback_field": "placeholder_name",
      "forbid_editor_name_fallback": true
    },
    "visible_description": {
      "hide_when": "survival_language<2",
      "identified_field": "fn",
      "identified_requires": ["identity_known", "survival_language>=4"],
      "otherwise_field": "fn_before"
    },
    "repair_use_requires": ["repair_use_known"],
    "compatibility_display_requires": ["component_seen", "tool_component_compatibility_known"],
    "no_knowledge_from": ["language_level_alone", "forging_level_alone", "purchase_alone", "transfer", "load_save", "open_panel", "attach_to_toolkit"],
    "forbid_unseen_component_enumeration": true,
    "forbid_unknown_tool_recommendation": true,
    "forbid_empty_group_headings": true,
    "always_hidden": ["editor_name", "item_id", "assembly_types", "tags", "base_value", "price_class", "volatility", "region_restrict", "source", "production_lines", "full_compatibility_map"],
    "weight": "沿用已经接触的实物重量显示与组合负重规则，不展示尚未接触工具的重量条目。",
    "action_policy": "认识控制显示，不增加维修操作门槛；已接触实物可实际检查和尝试使用，不必先知道正式名称。",
