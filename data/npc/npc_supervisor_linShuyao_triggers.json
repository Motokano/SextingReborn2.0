      "dialogue": {
        "linesRich": [
          {
            "speaker": "npc",
            "text": "（大意）林经理告诉主角：你已经被选为某个综艺节目的主人公。",
            "avatar": "image/npc_supervisor_linShuyao/19621d34d43ed73564d43d7437132a54.png"
          },
          {
            "speaker": "player",
            "text": "……你说什么？",
            "avatar": ""
          },
          {
            "speaker": "npc",
            "text": "（大意）这个节目的核心内容，是让你在这个世界里想办法找到回家的路。",
            "avatar": "image/npc_supervisor_linShuyao/19621d34d43ed73564d43d7437132a54.png"
          }
        ],
        "lines": [
          "（大意）林经理告诉主角：你已经被选为某个综艺节目的主人公。",
          "……你说什么？",
          "（大意）这个节目的核心内容，是让你在这个世界里想办法找到回家的路。"
        ],
        "hasOptions": false,
        "options": []
      },
      "effects": [
        {
          "type": "setFlag",
          "params": {
