  "entries": [
    {
      "id": "station.cooking.repair_intro",
      "entryType": "dialogue",
      "entrySource": "chat",
      "condition": {
        "type": "and",
        "conds": [
          {
            "type": "flagEquals",
            "flag": "cooking_base_station_unlocked",
            "value": false
          },
          {
            "type": "flagEquals",
            "flag": "cooking_base_station_repair_briefed",
            "value": false
          }
        ]
      },
      "requires": [],
      "blocks": [],
      "dialogue": {
        "linesRich": [
          {
            "speaker": "narration",
            "text": "灶台塌了一角，砖缝里塞着陈年油垢。旁边用炭条歪歪扭扭写着几个字：要修好，得找些黏土、干柴和一口能用的陶锅——齐了再来。",
            "avatar": ""
          }
        ],
        "lines": [
          "灶台塌了一角，砖缝里塞着陈年油垢。旁边用炭条歪歪扭扭写着几个字：要修好，得找些黏土、干柴和一口能用的陶锅——齐了再来。"
        ],
