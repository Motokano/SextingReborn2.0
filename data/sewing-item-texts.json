{
  "schema_version": 1,
  "status": "runtime_integrated",
  "scope": "缝纫运行物品文案；配方与实例信息仍受知识和语言规则约束，不是自动公开图鉴。",
  "display_contract": {
    "references": [
      "docs/design/01-philosophy.md",
      "docs/design/63-item-attribute-modules.md",
      "docs/design/66-item-assembly-information-and-ui.md"
    ],
    "language": {
      "name_below_3": "placeholder_name",
      "name_at_least_3": "sn",
      "description_below_2": "",
      "description_2_to_3": "fn_before",
      "description_at_least_4": "fn"
    },
    "discovery": "未通过世界内途径发现的条目不列出，不显示剪影、隐藏条目数或未发现配方。语言等级只控制已发现物品的称呼与说明，不授予材料加工或版型制作权限。",
    "observation": "外观文案仅写当前能观察的事实。随机颜色、材质、厚度、内层种类、硅叶状态不由固定描述猜测。部件归属、口袋和左右等须经过相应检查；未确认左右时使用不带左右的外观称呼。",
    "cognition": "组合内部实际用料、配比、处理状态、适配尺寸和性能均单独过滤；学会版型不等于看穿拾取实例的填充，知道工艺不等于知道实例随机系数。",
    "craft_record": "亲自完成制作、改造、浸泡或测量的事实可作为对应实例认识来源；发现、正式名称、工艺掌握、测量、性能认识分别保存。",
    "integration": "复用getDisplayName/getDisplayDesc及逐字段认知过滤；当前语言显示函数本身不提供本配置需要的所有实例知识门控，不得把conditional_texts直接拼入fn。",
    "existing_raw_materials": "羊毛、蚕茧、牛皮、羊皮沿用既有物品ID与认知文案；不重复注册、不自动鉴定。新增条目ID须在实施时与正式材料、部件模板对齐。"
  },
  "name_composition": {
    "base": "先选择当前可见的基础称呼；未认识款式时使用外观名称，不填入隐藏的style_key。衣服及部件名称不附加性别剪裁或材料前缀，这两类属性统一归入信息显示的缝纫模块；面料物品本身仍使用其材料名称。",
    "missing_format": "不完整的{base_name}",
    "forbidden": [
      "不从隐藏系数生成优质/劣质名称",
      "不因未浸泡或低属性自动加废品前缀",
      "不在标题暴露未知材料、填充配比、减伤、盾量或研究剩余次数",
      "不把硅叶处理自动写成耐久系统或永久无条件防御"
    ],
    "runtime_examples": [
      {
        "facts": "轻便款已认识、女装剪裁已确认、外层麻布已认识",
        "name": "轻便左短袖"
      },
      {
        "facts": "上述认知尚未具备且语言不足",
        "name": "一只短袖"
      },
      {
        "facts": "整体不同款式组合已确认，四男装两女装均已检查",
        "name": "混装衣服"
      }
    ]
  },
